<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".AdvisorDashboardActivity">

    <include layout="@layout/include_staff_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Advisor dashboard"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#0B132B" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="#B91C1C"
        android:accessibilityLiveRegion="polite" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/navBookings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Customer bookings"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navIntake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Customer intake"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navInspection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Vehicle inspection"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navJobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Job cards"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Diagnostic records"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navEstimates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Customer estimates"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navInvoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Invoices"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navHandover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Final handover"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navModifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Modifications"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Emergency requests"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/navNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Notifications"
                android:textAllCaps="false" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>