:root {

    --sd-navy: #0B132B;
    --sd-navy-light: #16213E;
    --sd-navy-soft: #1E2A48;

    --sd-orange: #F97316;
    --sd-orange-dark: #EA580C;
    --sd-orange-light: #FFF1E6;

    --sd-background: #F8FAFC;
    --sd-white: #FFFFFF;

    --sd-text: #0F172A;
    --sd-text-secondary: #64748B;
    --sd-text-light: #94A3B8;

    --sd-border: #E2E8F0;

    --sd-success: #15803D;
    --sd-success-soft: #DCFCE7;

    --sd-warning: #A16207;
    --sd-warning-soft: #FEF3C7;

    --sd-blue: #2563EB;
    --sd-blue-soft: #DBEAFE;

    --sd-danger: #DC2626;
}


* {
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {

    margin: 0;

    min-height: 100vh;

    font-family:
        Inter,
        Arial,
        sans-serif;

    color: var(--sd-text);

    background:
        var(--sd-background);
}


button,
input,
textarea,
select {
    font: inherit;
}


button {
    cursor: pointer;
}


.sd-dashboard {

    min-height: 100vh;

    display: grid;

    grid-template-columns:
        270px minmax(0, 1fr);
}



/* =====================================================
   SIDEBAR
   ===================================================== */

.sd-sidebar {

    position: fixed;

    inset:
        0
        auto
        0
        0;

    z-index: 1000;

    width: 270px;

    display: flex;

    flex-direction: column;

    padding: 24px 18px;

    color: var(--sd-white);

    background:
        linear-gradient(
            180deg,
            var(--sd-navy),
            var(--sd-navy-light)
        );

    overflow-y: auto;
}


.sd-sidebar-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    min-height: 56px;

    margin-bottom: 18px;
}


.sd-logo-link {
    display: inline-flex;
}


.sd-logo {

    display: block;

    width: 145px;

    max-width: 100%;
}


.sd-sidebar-close {

    display: none;

    width: 38px;
    height: 38px;

    border: 0;

    border-radius: 10px;

    color: var(--sd-white);

    background:
        rgba(255, 255, 255, 0.07);
}


.sd-user-card {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 26px;

    padding: 14px;

    border:
        1px solid
        rgba(255, 255, 255, 0.08);

    border-radius: 14px;

    background:
        rgba(255, 255, 255, 0.05);
}


.sd-user-avatar {

    flex: 0 0 42px;

    width: 42px;
    height: 42px;

    display: grid;

    place-items: center;

    border-radius: 12px;

    color: var(--sd-orange);

    background:
        rgba(249, 115, 22, 0.14);

    font-size: 1.1rem;
}


.sd-user-card strong,
.sd-user-card span {

    display: block;
}


.sd-user-card strong {

    font-size: 0.88rem;
}


.sd-user-card span {

    margin-top: 3px;

    color: #94A3B8;

    font-size: 0.72rem;
}


.sd-sidebar-nav {

    display: grid;

    gap: 6px;
}


.sd-nav-item {

    width: 100%;

    min-height: 46px;

    display: flex;

    align-items: center;

    gap: 12px;

    padding:
        10px
        13px;

    border: 0;

    border-radius: 11px;

    color: #CBD5E1;

    background: transparent;

    text-align: left;

    transition:
        background 0.2s ease,
        color 0.2s ease;
}


.sd-nav-item i {

    width: 20px;

    color: #94A3B8;

    font-size: 1rem;
}


.sd-nav-item:hover {

    color: var(--sd-white);

    background:
        rgba(255, 255, 255, 0.06);
}


.sd-nav-item.active {

    color: var(--sd-white);

    background:
        rgba(249, 115, 22, 0.15);
}


.sd-nav-item.active i {
    color: var(--sd-orange);
}


.sd-sidebar-footer {

    margin-top: auto;

    padding-top: 24px;
}


.sd-logout {

    min-height: 46px;

    display: flex;

    align-items: center;

    gap: 11px;

    padding:
        10px
        13px;

    border-radius: 11px;

    color: #CBD5E1;

    text-decoration: none;
}


.sd-logout:hover {

    color: var(--sd-white);

    background:
        rgba(255, 255, 255, 0.06);
}



/* =====================================================
   MAIN
   ===================================================== */

.sd-main {

    grid-column: 2;

    min-width: 0;
}


.sd-topbar {

    position: sticky;

    top: 0;

    z-index: 500;

    min-height: 82px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding:
        14px
        30px;

    border-bottom:
        1px solid
        var(--sd-border);

    background:
        rgba(255, 255, 255, 0.96);

    backdrop-filter:
        blur(12px);
}


.sd-topbar-left {

    display: flex;

    align-items: center;

    gap: 14px;
}


.sd-topbar-label {

    display: block;

    margin-bottom: 2px;

    color:
        var(--sd-text-secondary);

    font-size: 0.72rem;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.07em;
}


.sd-topbar h1 {

    margin: 0;

    font-size: 1.35rem;
}


.sd-menu-button {

    display: none;

    width: 42px;
    height: 42px;

    border:
        1px solid
        var(--sd-border);

    border-radius: 11px;

    color:
        var(--sd-text);

    background:
        var(--sd-white);

    font-size: 1.25rem;
}


.sd-topbar-actions {

    display: flex;

    align-items: center;

    gap: 18px;
}


.sd-icon-button {

    position: relative;

    width: 42px;
    height: 42px;

    display: grid;

    place-items: center;

    border:
        1px solid
        var(--sd-border);

    border-radius: 12px;

    color:
        var(--sd-text-secondary);

    background:
        var(--sd-white);
}


.sd-notification-dot {

    position: absolute;

    top: 8px;
    right: 8px;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background:
        var(--sd-orange);
}


.sd-topbar-profile {

    display: flex;

    align-items: center;

    gap: 10px;
}


.sd-profile-avatar {

    width: 40px;
    height: 40px;

    display: grid;

    place-items: center;

    border-radius: 11px;

    color: var(--sd-white);

    background:
        var(--sd-navy);

    font-size: 0.76rem;

    font-weight: 800;
}


.sd-topbar-profile strong,
.sd-topbar-profile span {

    display: block;
}


.sd-topbar-profile strong {

    font-size: 0.83rem;
}


.sd-topbar-profile span {

    margin-top: 2px;

    color:
        var(--sd-text-secondary);

    font-size: 0.72rem;
}


.sd-content {

    width: min(1500px, 100%);

    margin: 0 auto;

    padding: 30px;
}



/* =====================================================
   SECTIONS
   ===================================================== */

.sd-section {
    display: none;
}


.sd-section.active {

    display: block;

    animation:
        sdFadeIn 0.22s ease;
}


@keyframes sdFadeIn {

    from {
        opacity: 0;
        transform: translateY(4px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


.sd-section-heading {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 24px;
}


.sd-section-heading h2 {

    margin:
        6px
        0;

    font-size:
        clamp(1.65rem, 3vw, 2.1rem);
}


.sd-section-heading p {

    max-width: 720px;

    margin: 0;

    color:
        var(--sd-text-secondary);

    line-height: 1.6;
}


.sd-eyebrow {

    color:
        var(--sd-orange);

    font-size: 0.72rem;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 0.11em;
}



/* =====================================================
   WELCOME
   ===================================================== */

.sd-welcome-card {

    position: relative;

    overflow: hidden;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

    margin-bottom: 24px;

    padding:
        30px;

    border-radius: 20px;

    color:
        var(--sd-white);

    background:
        radial-gradient(
            circle at 90% 10%,
            rgba(249, 115, 22, 0.3),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            var(--sd-navy),
            var(--sd-navy-light)
        );
}


.sd-welcome-card h2 {

    margin:
        9px
        0
        10px;

    font-size:
        clamp(1.65rem, 3vw, 2.2rem);
}


.sd-welcome-card p {

    max-width: 650px;

    margin: 0;

    color: #CBD5E1;

    line-height: 1.65;
}



/* =====================================================
   BUTTONS
   ===================================================== */

.sd-primary-button,
.sd-secondary-button {

    min-height: 44px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    padding:
        10px
        17px;

    border-radius: 11px;

    font-weight: 800;

    transition:
        transform 0.18s ease,
        background 0.18s ease;
}


.sd-primary-button {

    border: 0;

    color:
        var(--sd-white);

    background:
        var(--sd-orange);
}


.sd-primary-button:hover {

    background:
        var(--sd-orange-dark);

    transform:
        translateY(-1px);
}


.sd-primary-button:disabled {

    opacity: 0.45;

    cursor: not-allowed;

    transform: none;
}


.sd-secondary-button {

    border:
        1px solid
        var(--sd-border);

    color:
        var(--sd-text);

    background:
        var(--sd-white);
}


.sd-secondary-button:hover {
    background: #F1F5F9;
}


.sd-full-button {

    width: 100%;

    margin-top: 20px;
}


.sd-text-button {

    border: 0;

    padding: 0;

    color:
        var(--sd-orange-dark);

    background: transparent;

    font-weight: 800;
}



/* =====================================================
   STATS
   ===================================================== */

.sd-stat-grid {

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 18px;

    margin-bottom: 24px;
}


.sd-stat-card {

    display: flex;

    align-items: center;

    gap: 15px;

    padding: 20px;

    border:
        1px solid
        var(--sd-border);

    border-radius: 17px;

    background:
        var(--sd-white);

    box-shadow:
        0 8px 30px
        rgba(15, 23, 42, 0.035);
}


.sd-stat-icon {

    flex: 0 0 48px;

    width: 48px;
    height: 48px;

    display: grid;

    place-items: center;

    border-radius: 13px;

    color:
        var(--sd-orange);

    background:
        var(--sd-orange-light);

    font-size: 1.15rem;
}


.sd-stat-card span,
.sd-stat-card strong,
.sd-stat-card small {

    display: block;
}


.sd-stat-card span {

    color:
        var(--sd-text-secondary);

    font-size: 0.75rem;

    font-weight: 700;
}


.sd-stat-card strong {

    margin:
        3px
        0;

    font-size: 1.45rem;
}


.sd-stat-card small {

    color:
        var(--sd-text-light);

    font-size: 0.69rem;
}



/* =====================================================
   PANELS
   ===================================================== */

.sd-panel {

    padding: 23px;

    border:
        1px solid
        var(--sd-border);

    border-radius: 18px;

    background:
        var(--sd-white);

    box-shadow:
        0 8px 30px
        rgba(15, 23, 42, 0.035);
}


.sd-overview-grid {

    display: grid;

    grid-template-columns:
        minmax(0, 1.4fr)
        minmax(320px, 0.6fr);

    gap: 20px;
}


.sd-two-column {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 20px;
}


.sd-panel-heading {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin-bottom: 20px;
}


.sd-panel-heading h3 {

    margin:
        5px
        0
        0;

    font-size: 1.08rem;
}



/* =====================================================
   ACTIVITY
   ===================================================== */

.sd-activity-list {

    display: grid;
}


.sd-activity-item {

    display: grid;

    grid-template-columns:
        auto
        minmax(0, 1fr)
        auto;

    align-items: center;

    gap: 13px;

    padding:
        16px
        0;

    border-bottom:
        1px solid
        var(--sd-border);
}


.sd-activity-item:last-child {
    border-bottom: 0;
}


.sd-activity-marker {

    width: 9px;
    height: 9px;

    border-radius: 50%;

    background:
        var(--sd-orange);
}


.sd-activity-item strong,
.sd-activity-item span {

    display: block;
}


.sd-activity-item > div > span {

    margin-top: 4px;

    color:
        var(--sd-text-secondary);

    font-size: 0.76rem;
}



/* =====================================================
   STATUS
   ===================================================== */

.sd-status {

    display: inline-flex !important;

    align-items: center;

    justify-content: center;

    width: fit-content;

    padding:
        5px
        9px;

    border-radius: 999px;

    font-size: 0.69rem;

    font-weight: 800;
}


.sd-status-progress {

    color:
        var(--sd-blue);

    background:
        var(--sd-blue-soft);
}


.sd-status-waiting {

    color:
        var(--sd-warning);

    background:
        var(--sd-warning-soft);
}


.sd-status-ready {

    color:
        var(--sd-success);

    background:
        var(--sd-success-soft);
}



/* =====================================================
   QUICK ACTIONS
   ===================================================== */

.sd-quick-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;
}


.sd-quick-card {

    min-height: 110px;

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    justify-content: space-between;

    gap: 14px;

    padding: 16px;

    border:
        1px solid
        var(--sd-border);

    border-radius: 14px;

    color:
        var(--sd-text);

    background:
        var(--sd-background);

    text-align: left;

    font-weight: 800;
}


.sd-quick-card:hover {

    border-color:
        rgba(249, 115, 22, 0.35);

    background:
        var(--sd-orange-light);
}


.sd-quick-card i {

    color:
        var(--sd-orange);

    font-size: 1.2rem;
}



/* =====================================================
   FORMS
   ===================================================== */

.sd-form-panel {

    display: grid;

    gap: 22px;
}


.sd-form-section-title {

    display: flex;

    align-items: center;

    gap: 9px;

    padding-bottom: 12px;

    border-bottom:
        1px solid
        var(--sd-border);

    font-weight: 800;
}


.sd-form-section-title i {
    color: var(--sd-orange);
}


.sd-form-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 18px;
}


.sd-field label {

    display: block;

    margin-bottom: 7px;

    font-size: 0.78rem;

    font-weight: 800;
}


.sd-field input,
.sd-field textarea,
.sd-field select {

    width: 100%;

    border:
        1px solid
        var(--sd-border);

    border-radius: 11px;

    outline: 0;

    color:
        var(--sd-text);

    background:
        var(--sd-white);

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}


.sd-field input,
.sd-field select {

    min-height: 47px;

    padding:
        10px
        12px;
}


.sd-field textarea {

    resize: vertical;

    min-height: 110px;

    padding: 12px;

    line-height: 1.5;
}


.sd-field input:focus,
.sd-field textarea:focus,
.sd-field select:focus {

    border-color:
        var(--sd-orange);

    box-shadow:
        0 0 0 3px
        rgba(249, 115, 22, 0.11);
}


.sd-field-full {

    grid-column: 1 / -1;
}


.sd-form-actions {

    display: flex;

    justify-content: flex-end;

    flex-wrap: wrap;

    gap: 10px;
}


.sd-form-message {

    min-height: 18px;

    margin-top: 10px;

    font-size: 0.79rem;

    font-weight: 800;
}


.sd-form-message.success {
    color: var(--sd-success);
}


.sd-form-message.error {
    color: var(--sd-danger);
}



/* =====================================================
   INSPECTION
   ===================================================== */

.sd-progress-box {

    min-width: 150px;

    padding:
        11px
        14px;

    border:
        1px solid
        var(--sd-border);

    border-radius: 12px;

    background:
        var(--sd-white);

    text-align: right;
}


.sd-progress-box span,
.sd-progress-box strong {

    display: block;
}


.sd-progress-box span {

    color:
        var(--sd-text-secondary);

    font-size: 0.7rem;
}


.sd-progress-box strong {

    margin-top: 2px;

    font-size: 0.95rem;
}


.sd-vehicle-summary {

    display: flex;

    align-items: center;

    gap: 13px;

    margin-bottom: 22px;

    padding-bottom: 20px;

    border-bottom:
        1px solid
        var(--sd-border);
}


.sd-vehicle-icon {

    flex: 0 0 48px;

    width: 48px;
    height: 48px;

    display: grid;

    place-items: center;

    border-radius: 13px;

    color:
        var(--sd-orange);

    background:
        var(--sd-orange-light);

    font-size: 1.2rem;
}


.sd-vehicle-summary strong,
.sd-vehicle-summary span {

    display: block;
}


.sd-vehicle-summary span {

    margin-top: 3px;

    color:
        var(--sd-text-secondary);

    font-size: 0.78rem;
}


.sd-inspection-grid {

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 13px;

    margin-bottom: 24px;
}


.sd-check-card {

    position: relative;

    display: flex;

    align-items: center;

    gap: 11px;

    min-height: 90px;

    padding: 14px;

    border:
        1px solid
        var(--sd-border);

    border-radius: 13px;

    background:
        var(--sd-background);

    cursor: pointer;

    transition:
        border-color 0.2s ease,
        background 0.2s ease;
}


.sd-check-card input {

    position: absolute;

    opacity: 0;

    pointer-events: none;
}


.sd-check-icon {

    flex: 0 0 30px;

    width: 30px;
    height: 30px;

    display: grid;

    place-items: center;

    border-radius: 9px;

    color:
        var(--sd-text-light);

    background:
        var(--sd-white);
}


.sd-check-card strong,
.sd-check-card small {

    display: block;
}


.sd-check-card strong {

    font-size: 0.8rem;
}


.sd-check-card small {

    margin-top: 4px;

    color:
        var(--sd-text-secondary);

    font-size: 0.68rem;

    line-height: 1.4;
}


.sd-check-card.checked {

    border-color:
        rgba(21, 128, 61, 0.28);

    background:
        var(--sd-success-soft);
}


.sd-check-card.checked .sd-check-icon {

    color:
        var(--sd-success);
}



/* =====================================================
   TABLE
   ===================================================== */

.sd-table-panel {
    padding: 0;
}


.sd-table-wrap {

    width: 100%;

    overflow-x: auto;
}


.sd-table {

    width: 100%;

    border-collapse: collapse;

    min-width: 780px;
}


.sd-table th {

    padding:
        14px
        17px;

    border-bottom:
        1px solid
        var(--sd-border);

    color:
        var(--sd-text-secondary);

    background:
        #F8FAFC;

    font-size: 0.7rem;

    text-align: left;

    text-transform: uppercase;

    letter-spacing: 0.04em;
}


.sd-table td {

    padding:
        16px
        17px;

    border-bottom:
        1px solid
        var(--sd-border);

    font-size: 0.81rem;
}


.sd-table tbody tr:last-child td {
    border-bottom: 0;
}


.sd-table td small {

    display: block;

    margin-top: 4px;

    color:
        var(--sd-text-secondary);
}


.sd-table-button {

    border: 0;

    padding:
        7px
        10px;

    border-radius: 8px;

    color:
        var(--sd-orange-dark);

    background:
        var(--sd-orange-light);

    font-weight: 800;
}



/* =====================================================
   NOTES
   ===================================================== */

.sd-note-summary {

    display: grid;

    gap: 0;
}


.sd-note-summary > div {

    padding:
        14px
        0;

    border-bottom:
        1px solid
        var(--sd-border);
}


.sd-note-summary > div:last-child {
    border-bottom: 0;
}


.sd-note-summary span,
.sd-note-summary strong {

    display: block;
}


.sd-note-summary span {

    margin-bottom: 5px;

    color:
        var(--sd-text-secondary);

    font-size: 0.7rem;

    font-weight: 700;

    text-transform: uppercase;
}


.sd-note-summary strong {

    font-size: 0.82rem;

    line-height: 1.55;
}



/* =====================================================
   ESTIMATE
   ===================================================== */

.sd-estimate-layout {

    grid-template-columns:
        minmax(0, 1.4fr)
        minmax(300px, 0.6fr);
}


.sd-total-card h3 {

    margin:
        7px
        0
        20px;
}


.sd-total-row {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    padding:
        11px
        0;

    border-bottom:
        1px solid
        var(--sd-border);

    font-size: 0.8rem;
}


.sd-total-row span {
    color: var(--sd-text-secondary);
}


.sd-grand-total {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin-top: 18px;

    padding:
        17px;

    border-radius: 13px;

    color:
        var(--sd-white);

    background:
        var(--sd-navy);
}


.sd-grand-total strong {

    font-size: 1.12rem;
}



/* =====================================================
   INVOICE
   ===================================================== */

.sd-invoice-header {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 20px;
}


.sd-invoice-header h3 {

    margin:
        4px
        0
        0;
}


.sd-invoice-header > div:last-child {

    text-align: right;
}


.sd-invoice-header > div:last-child span,
.sd-invoice-header > div:last-child strong {

    display: block;
}


.sd-invoice-header > div:last-child span {

    margin-bottom: 4px;

    color:
        var(--sd-text-secondary);

    font-size: 0.75rem;
}


.sd-invoice-total {

    display: flex;

    justify-content: flex-end;

    align-items: center;

    gap: 30px;

    padding:
        20px
        0;

    border-top:
        1px solid
        var(--sd-border);
}


.sd-invoice-total span {

    color:
        var(--sd-text-secondary);

    font-weight: 700;
}


.sd-invoice-total strong {

    font-size: 1.3rem;
}



/* =====================================================
   HANDOVER
   ===================================================== */

.sd-handover-vehicle {

    display: flex;

    align-items: center;

    gap: 14px;

    margin-bottom: 24px;
}


.sd-handover-vehicle span {

    color:
        var(--sd-success);

    font-size: 0.72rem;

    font-weight: 800;
}


.sd-handover-vehicle h3 {

    margin:
        4px
        0;
}


.sd-handover-vehicle p {

    margin: 0;

    color:
        var(--sd-text-secondary);

    font-size: 0.78rem;
}


.sd-handover-checks {

    display: grid;

    gap: 10px;
}


.sd-handover-checks label {

    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 46px;

    padding:
        10px
        12px;

    border:
        1px solid
        var(--sd-border);

    border-radius: 10px;

    font-size: 0.8rem;

    cursor: pointer;
}


.sd-handover-checks input {
    accent-color: var(--sd-orange);
}



/* =====================================================
   MOBILE SIDEBAR OVERLAY
   ===================================================== */

.sd-sidebar-overlay {

    position: fixed;

    inset: 0;

    z-index: 900;

    display: none;

    background:
        rgba(11, 19, 43, 0.55);
}



/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 1180px) {

    .sd-stat-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }


    .sd-inspection-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}


@media (max-width: 980px) {

    .sd-dashboard {
        grid-template-columns: 1fr;
    }


    .sd-main {
        grid-column: 1;
    }


    .sd-sidebar {

        width: 280px;

        transform:
            translateX(-100%);

        transition:
            transform 0.25s ease;
    }


    .sd-sidebar.open {
        transform: translateX(0);
    }


    .sd-sidebar-close,
    .sd-menu-button {
        display: grid;
        place-items: center;
    }


    .sd-sidebar-overlay.open {
        display: block;
    }


    .sd-overview-grid,
    .sd-two-column,
    .sd-estimate-layout {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 700px) {

    .sd-content {
        padding: 20px;
    }


    .sd-topbar {
        padding:
            13px
            20px;
    }


    .sd-topbar-profile > div:last-child {
        display: none;
    }


    .sd-stat-grid,
    .sd-form-grid,
    .sd-inspection-grid {
        grid-template-columns: 1fr;
    }


    .sd-section-heading,
    .sd-welcome-card {

        align-items: flex-start;

        flex-direction: column;
    }


    .sd-welcome-card .sd-primary-button {
        width: 100%;
    }


    .sd-progress-box {

        width: 100%;

        text-align: left;
    }


    .sd-quick-grid {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 480px) {

    .sd-content {
        padding: 16px;
    }


    .sd-topbar {
        padding:
            12px
            16px;
    }


    .sd-panel,
    .sd-welcome-card {
        padding: 18px;
    }


    .sd-topbar-actions {
        gap: 8px;
    }


    .sd-topbar-label {
        display: none;
    }


    .sd-topbar h1 {
        font-size: 1.05rem;
    }

}

/* =========================================================
   SHIFT DYNAMICS SIDEBAR BRAND
   ========================================================= */

.sd-dashboard-brand {
    width: 100%;
    min-height: 80px;
    padding: 16px 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sd-dashboard-brand img {
    display: block;

    width: 100%;
    max-width: 190px;
    height: auto;

    object-fit: contain;
}


/* =========================================================
   SHIFT DYNAMICS FULL DASHBOARD BRAND
   ========================================================= */

.sd-dashboard-brand {
    width: 100%;
    min-height: 78px;
    padding: 16px 14px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);

    text-decoration: none;
}

.sd-dashboard-logo {
    display: block;

    width: 82px;
    height: auto;

    flex: 0 0 auto;

    object-fit: contain;
}

.sd-dashboard-brand-name {
    color: #FFFFFF;

    font-size: 15px;
    font-weight: 800;

    letter-spacing: -0.03em;

    white-space: nowrap;
}

.sd-dashboard-brand-name > span {
    color: #F97316;
}

@media (max-width: 520px) {

    .sd-dashboard-logo {
        width: 74px;
    }

    .sd-dashboard-brand-name {
        font-size: 14px;
    }

}

/* =========================================================
   DASHBOARD BRAND SIZE FIX
   ========================================================= */

.sd-dashboard-brand {
    box-sizing: border-box !important;

    width: 100% !important;
    max-width: 100% !important;
    min-height: 78px !important;

    padding: 14px 12px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;

    gap: 8px !important;

    overflow: hidden !important;

    text-decoration: none !important;
}

.sd-dashboard-brand .sd-dashboard-logo {
    display: block !important;

    width: 78px !important;
    max-width: 78px !important;
    height: auto !important;

    flex: 0 0 78px !important;

    object-fit: contain !important;
}

.sd-dashboard-brand .sd-dashboard-brand-name {
    display: block !important;

    min-width: 0 !important;

    color: #FFFFFF !important;

    font-size: 12px !important;
    line-height: 1 !important;
    font-weight: 800 !important;

    letter-spacing: -0.02em !important;

    white-space: nowrap !important;
}

.sd-dashboard-brand .sd-dashboard-brand-name > span {
    color: #F97316 !important;
}

