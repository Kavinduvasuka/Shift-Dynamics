/* ==========================================================================
   ShiftDynamics - Automotive Care SaaS Design System
   Brand Identity:
   - Primary: Automotive Orange (#FF7A00)
   - Secondary: Dark Charcoal (#222222)
   - Background: Warm Off-White / Cream (#F7F3EC)
   - Card Surface: White (#FFFFFF)
   ========================================================================== */

:root {
  --color-orange-primary: #FF7A00;
  --color-orange-hover: #E06B00;
  --color-orange-light: #FFF2E6;
  --color-charcoal-dark: #222222;
  --color-charcoal-surface: #2D2D2D;
  --color-charcoal-muted: #4A4A4A;
  --color-bg-cream: #F7F3EC;
  --color-card-white: #FFFFFF;
  --color-border-subtle: #E5E0D8;
  --color-success: #10B981;
  --color-warning: #F59E0B;
  --color-danger: #EF4444;
  --color-info: #3B82F6;

  --font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --radius-full: 9999px;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.15);
}

/* Reset & Base Styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--color-bg-cream);
  color: var(--color-charcoal-dark);
  font-family: var(--font-family);
  line-height: 1.5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
}

/* Speedline Accent Styling */
.speed-line-top {
  border-top: 4px solid var(--color-orange-primary);
}

/* Utility Classes */
.bg-charcoal { background-color: var(--color-charcoal-dark); color: white; }
.bg-[#2D2D2D] { background-color: var(--color-charcoal-surface); }
.text-orange { color: var(--color-orange-primary); }
.bg-orange { background-color: var(--color-orange-primary); color: white; }
.bg-cream { background-color: var(--color-bg-cream); }
.bg-white { background-color: var(--color-card-white); }

/* Layout Grid & Containers */
.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* Buttons */
.btn {
  display: inline-flex;
  items-center: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: center;
}

.btn-primary {
  background-color: var(--color-orange-primary);
  color: #ffffff;
  box-shadow: var(--shadow-sm);
}

.btn-primary:hover {
  background-color: var(--color-orange-hover);
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.btn-secondary {
  background-color: var(--color-charcoal-dark);
  color: #ffffff;
}

.btn-secondary:hover {
  background-color: var(--color-charcoal-surface);
}

.btn-outline {
  background-color: transparent;
  border: 2px solid var(--color-charcoal-dark);
  color: var(--color-charcoal-dark);
}

.btn-outline:hover {
  background-color: var(--color-charcoal-dark);
  color: #ffffff;
}

.btn-danger {
  background-color: var(--color-danger);
  color: #ffffff;
}

.btn-danger:hover {
  background-color: #dc2626;
}

.btn-sm { padding: 0.375rem 0.75rem; font-size: 0.75rem; }
.btn-lg { padding: 0.875rem 1.75rem; font-size: 1rem; }

/* Status Badges */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 700;
  border-radius: var(--radius-full);
  border: 1px solid transparent;
}

.badge-in-progress { background-color: #FEF3C7; color: #92400E; border-color: #FDE68A; }
.badge-completed { background-color: #D1FAE5; color: #065F46; border-color: #A7F3D0; }
.badge-approved { background-color: #DBEAFE; color: #1E40AF; border-color: #BFDBFE; }
.badge-pending { background-color: #F3F4F6; color: #374151; border-color: #E5E7EB; }
.badge-rejected { background-color: #FEE2E2; color: #991B1B; border-color: #FECACA; }

/* Cards & Surfaces */
.card {
  background-color: var(--color-card-white);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
}

/* Modal Overlay */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.modal-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  background-color: var(--color-card-white);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 600px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--color-border-subtle);
}

.modal-header {
  padding: 1.25rem 1.5rem;
  background-color: var(--color-bg-cream);
  border-bottom: 1px solid var(--color-border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-body {
  padding: 1.5rem;
}

/* Header & Topbar */
.app-header {
  height: 64px;
  background-color: #ffffff;
  border-bottom: 1px solid var(--color-border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 1.5rem;
  position: sticky;
  top: 0;
  z-index: 30;
}

/* Sidebar Navigation */
.app-sidebar {
  width: 260px;
  background-color: var(--color-charcoal-dark);
  color: #ffffff;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  z-index: 40;
  border-right: 1px solid #333333;
}

.sidebar-logo {
  height: 64px;
  padding: 0 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background-color: #1A1A1A;
  border-bottom: 1px solid #333333;
}

.sidebar-nav {
  flex: 1;
  padding: 1rem 0.75rem;
  overflow-y: auto;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  color: #D4CEB8;
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: var(--radius-md);
  margin-bottom: 0.25rem;
  transition: all 0.2s ease;
}

.nav-item:hover {
  background-color: var(--color-charcoal-surface);
  color: #ffffff;
}

.nav-item.active {
  background-color: var(--color-orange-primary);
  color: #ffffff;
  box-shadow: var(--shadow-sm);
}

/* Quick Role Switcher Bar */
.role-switcher-bar {
  background-color: var(--color-charcoal-dark);
  color: #ffffff;
  padding: 0.75rem 1rem;
  border-radius: var(--radius-md);
  border: 1px solid #333333;
  margin-bottom: 1.5rem;
}

.role-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.role-btn {
  padding: 0.5rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 700;
  background-color: var(--color-charcoal-surface);
  color: #E5E0D8;
  border: 1px solid #444444;
  border-radius: var(--radius-sm);
  cursor: pointer;
  text-align: left;
  transition: all 0.2s ease;
}

.role-btn:hover {
  border-color: var(--color-orange-primary);
  color: #ffffff;
}

.role-btn.active {
  background-color: var(--color-orange-primary);
  border-color: var(--color-orange-primary);
  color: #ffffff;
}

/* Tables */
.table-container {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.875rem;
}

th {
  background-color: var(--color-bg-cream);
  padding: 0.75rem 1rem;
  font-weight: 800;
  text-transform: uppercase;
  font-size: 0.75rem;
  color: var(--color-charcoal-muted);
}

td {
  padding: 1rem;
  border-bottom: 1px solid #F0EAE1;
}

tr:hover td {
  background-color: #FDFBF7;
}

/* Form Controls */
.form-group {
  margin-bottom: 1rem;
}

.form-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  margin-bottom: 0.375rem;
  color: var(--color-charcoal-dark);
}

.form-control {
  width: 100%;
  padding: 0.625rem 0.875rem;
  font-size: 0.875rem;
  background-color: #FAF8F5;
  border: 1px solid #D8D2C7;
  border-radius: var(--radius-md);
  outline: none;
  transition: border-color 0.2s ease;
}

.form-control:focus {
  border-color: var(--color-orange-primary);
  background-color: #ffffff;
}

/* Responsive adjustments */
@media (max-width: 1024px) {
  .app-sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }
  .app-sidebar.open {
    transform: translateX(0);
  }
  .main-content {
    margin-left: 0 !important;
  }
}
